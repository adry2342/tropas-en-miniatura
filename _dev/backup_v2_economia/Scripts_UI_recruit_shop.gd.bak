extends CanvasLayer
## Tienda de reclutamiento de la fase de planificación (SPEC v2 §9).
## Se abre al pulsar un hueco vacío del ejército. Ofrece 3 reclutas únicos (UnitFactory.make_recruit)
## guardados en GameStateManager.shop_offers (se generan la primera vez que se abre en la ronda;
## el núcleo la vacía en advance_stage/reset_run). Al comprar, la oferta queda como "Reclutado" (null).

const OFFER_COUNT := 3
const CARD_W := 238.0

var _offers_box: HBoxContainer
var _gold_label: Label
var _slots_label: Label
var _buy_buttons: Dictionary = {} # TroopCard -> Button


func _ready() -> void:
	layer = 25
	visible = false
	_build_ui()
	EventBus.recruit_shop_requested.connect(open)
	EventBus.roster_changed.connect(_refresh)
	EventBus.battle_fight_started.connect(close)


func _exit_tree() -> void:
	if visible:
		_set_blocking(false)


func _unhandled_key_input(event: InputEvent) -> void:
	if visible and event.is_action_pressed("ui_cancel"):
		close()
		get_viewport().set_input_as_handled()


func open() -> void:
	ensure_offers()
	visible = true
	_set_blocking(true)
	_rebuild_offers()
	_refresh()


func close() -> void:
	if not visible:
		return
	visible = false
	_set_blocking(false)


func _set_blocking(value: bool) -> void:
	var gsm = get_node_or_null("/root/GameStateManager")
	if gsm:
		gsm.ui_blocking = value


## Genera las 3 ofertas de la ronda si aún no existen.
func ensure_offers() -> void:
	var gsm = get_node_or_null("/root/GameStateManager")
	if gsm == null:
		return
	if gsm.shop_offers.is_empty():
		for i in OFFER_COUNT:
			gsm.shop_offers.append(UnitFactory.make_recruit())


## Ofertas que aún se pueden comprar.
func get_offers() -> Array[TroopCard]:
	var out: Array[TroopCard] = []
	var gsm = get_node_or_null("/root/GameStateManager")
	if gsm:
		for o in gsm.shop_offers:
			if o is TroopCard:
				out.append(o)
	return out


## Compra un recluta. Devuelve true si se ha reclutado.
func buy(card: TroopCard) -> bool:
	var gsm = get_node_or_null("/root/GameStateManager")
	if gsm == null or card == null:
		return false
	var idx: int = gsm.shop_offers.find(card)
	if idx < 0:
		return false
	if not gsm.recruit_troop(card, UnitFactory.recruit_price(card)):
		return false
	gsm.shop_offers[idx] = null # la oferta desaparece (hueco "Reclutado")
	_rebuild_offers()
	_refresh()
	if not gsm.has_free_army_slot():
		close()
	return true


func _refresh() -> void:
	if not visible:
		return
	var gsm = get_node_or_null("/root/GameStateManager")
	var gold: int = gsm.gold if gsm else 0
	var free_slots: int = (gsm.MAX_ARMY_SIZE - gsm.get_army_size()) if gsm else 0
	_gold_label.text = "💰 %d" % gold
	_slots_label.text = "Huecos libres en el ejército: %d / %d" % [maxi(free_slots, 0), gsm.MAX_ARMY_SIZE if gsm else 6]
	for c in _buy_buttons:
		if not is_instance_valid(_buy_buttons[c]):
			continue
		var btn: Button = _buy_buttons[c]
		var price := UnitFactory.recruit_price(c)
		var affordable: bool = gold >= price
		btn.disabled = not affordable or free_slots <= 0
		if free_slots <= 0:
			btn.text = "Ejército lleno"
		elif not affordable:
			btn.text = "Faltan %d 💰" % (price - gold)
		else:
			btn.text = "Reclutar · %d 💰" % price


func _on_dim_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		close()


# ---------------------------------------------------------------- UI

func _build_ui() -> void:
	var root := Control.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(root)

	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0.02, 0.68)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	dim.gui_input.connect(_on_dim_input)
	root.add_child(dim)

	var center := CenterContainer.new()
	center.set_anchors_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(center)

	var panel := UiKit.panel(UiKit.BG, UiKit.GOLD, 12, 2, 18)
	panel.name = "ShopPanel"
	center.add_child(panel)

	var main := VBoxContainer.new()
	main.add_theme_constant_override("separation", 10)
	panel.add_child(main)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 16)
	main.add_child(header)
	var title := UiKit.label("🏕️ RECLUTAR TROPAS", 24, UiKit.TEXT)
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(title)
	_gold_label = UiKit.label("", 20, UiKit.GOLD)
	header.add_child(_gold_label)
	var close_btn := Button.new()
	close_btn.text = "✕"
	close_btn.custom_minimum_size = Vector2(40, 36)
	UiKit.style_button(close_btn, UiKit.PANEL_2, UiKit.BORDER)
	close_btn.pressed.connect(close)
	header.add_child(close_btn)

	_slots_label = UiKit.label("", 13, UiKit.MUTED)
	main.add_child(_slots_label)

	_offers_box = HBoxContainer.new()
	_offers_box.add_theme_constant_override("separation", 14)
	main.add_child(_offers_box)

	var hint := UiKit.label("Cada recluta es único: nombre, Vida, Daño y arma inicial. Llegan a la reserva (Nv. 1); arrástralos al tablero.", 12, UiKit.MUTED)
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	main.add_child(hint)


func _rebuild_offers() -> void:
	for c in _offers_box.get_children():
		_offers_box.remove_child(c)
		c.queue_free()
	_buy_buttons.clear()
	var gsm = get_node_or_null("/root/GameStateManager")
	if gsm == null:
		return
	for o in gsm.shop_offers:
		if o is TroopCard:
			_offers_box.add_child(_make_offer(o))
		else:
			_offers_box.add_child(_make_sold())


func _make_offer(card: TroopCard) -> Control:
	var pc := UiKit.make_recruit_card(card, CARD_W)
	var box: VBoxContainer = pc.get_meta("box")
	var btn := Button.new()
	btn.custom_minimum_size = Vector2(0, 40)
	btn.add_theme_font_size_override("font_size", 15)
	UiKit.style_button(btn, Color(0.3, 0.24, 0.06), UiKit.GOLD, Color(1.0, 0.93, 0.65))
	btn.pressed.connect(func():
		if buy(card):
			pass)
	box.add_child(btn)
	_buy_buttons[card] = btn
	return pc


func _make_sold() -> Control:
	var pc := UiKit.panel(Color(0.09, 0.1, 0.13, 0.8), Color(0.3, 0.34, 0.42, 0.5), 10, 1, 12)
	pc.custom_minimum_size = Vector2(CARD_W, 0)
	var l := UiKit.label("✔ Reclutado", 18, Color(0.5, 0.8, 0.55))
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	pc.add_child(l)
	return pc
