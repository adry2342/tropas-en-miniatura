class_name UiKit
extends RefCounted
## Utilidades visuales comunes de la interfaz (colores, estilos y fichas de tropa).

const DEFAULT_SPRITE: Texture2D = preload("res://Assets/Sprites/sprite-personaje-basico.png")

const RARITY_COLORS: Array[Color] = [
	Color(0.82, 0.85, 0.9),  # Común
	Color(0.35, 0.65, 1.0),  # Rara
	Color(0.75, 0.45, 1.0),  # Épica
	Color(1.0, 0.78, 0.2),   # Legendaria
]
const RARITY_NAMES: Array[String] = ["Común", "Rara", "Épica", "Legendaria"]

## Paleta de la interfaz
const BG := Color(0.075, 0.085, 0.11, 1.0)
const PANEL := Color(0.12, 0.135, 0.17, 1.0)
const PANEL_2 := Color(0.165, 0.18, 0.225, 1.0)
const BORDER := Color(0.3, 0.34, 0.42, 1.0)
const TEXT := Color(0.93, 0.94, 0.96)
const MUTED := Color(0.62, 0.66, 0.74)
const GOLD := Color(1.0, 0.82, 0.25)
const HEALTH := Color(0.42, 0.9, 0.5)
const DAMAGE := Color(1.0, 0.5, 0.35)
const RECRUIT := Color(0.82, 0.84, 0.88)
const UP := Color(0.45, 0.95, 0.5)
const DOWN := Color(1.0, 0.45, 0.4)

## Tipos de oferta de subida de nivel: etiqueta, color y aclaración.
const OFFER_TYPES := {
	"specialty": {"label": "ESPECIALIDAD", "color": Color(0.66, 0.4, 1.0), "hint": "Define su rol"},
	"skill": {"label": "HABILIDAD", "color": Color(0.3, 0.6, 1.0), "hint": "No ocupa hueco"},
	"item": {"label": "OBJETO", "color": Color(1.0, 0.58, 0.18), "hint": "Ocupa 1 hueco"},
	"weapon": {"label": "ARMA", "color": Color(0.95, 0.28, 0.28), "hint": "Se añade al arsenal"},
}


## Emojis que la fuente actual no dibuja (salen como "caja") → equivalente que sí se ve.
const EMOJI_FALLBACK := {"🪖": "🎖️", "⛓️": "🔗", "⛓": "🔗"}


static func emo(e: String) -> String:
	return EMOJI_FALLBACK.get(e, e)


static func rarity_color(r: int) -> Color:
	return RARITY_COLORS[clampi(r, 0, RARITY_COLORS.size() - 1)]


static func rarity_name(r: int) -> String:
	return RARITY_NAMES[clampi(r, 0, RARITY_NAMES.size() - 1)]


static func style(bg: Color, border: Color = Color(0, 0, 0, 0), radius: int = 8, border_w: int = 0, pad: float = 10.0) -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.bg_color = bg
	sb.border_color = border
	sb.set_border_width_all(border_w)
	sb.set_corner_radius_all(radius)
	sb.set_content_margin_all(pad)
	sb.anti_aliasing = true
	return sb


static func panel(bg: Color, border: Color = Color(0, 0, 0, 0), radius: int = 8, border_w: int = 0, pad: float = 10.0) -> PanelContainer:
	var p := PanelContainer.new()
	p.add_theme_stylebox_override("panel", style(bg, border, radius, border_w, pad))
	return p


static func label(text: String, size: int = 14, color: Color = TEXT) -> Label:
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l


static func wrap_label(text: String, size: int = 13, color: Color = MUTED, min_w: float = 0.0) -> Label:
	var l := label(text, size, color)
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	if min_w > 0.0:
		l.custom_minimum_size.x = min_w
	return l


## Aplica estilos normal/hover/pressed/disabled a un botón.
static func style_button(btn: Button, bg: Color, border: Color, font_color: Color = TEXT, radius: int = 6, pad: float = 6.0) -> void:
	var normal := style(bg, border, radius, 1, pad)
	var hover := style(bg.lightened(0.12), border.lightened(0.25), radius, 2, pad)
	var pressed := style(bg.darkened(0.15), border, radius, 2, pad)
	var disabled := style(Color(bg.r, bg.g, bg.b, bg.a * 0.45).darkened(0.3), Color(border, 0.3), radius, 1, pad)
	btn.add_theme_stylebox_override("normal", normal)
	btn.add_theme_stylebox_override("hover", hover)
	btn.add_theme_stylebox_override("pressed", pressed)
	btn.add_theme_stylebox_override("disabled", disabled)
	btn.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
	btn.add_theme_color_override("font_color", font_color)
	btn.add_theme_color_override("font_hover_color", font_color.lightened(0.2))
	btn.add_theme_color_override("font_pressed_color", font_color)
	btn.add_theme_color_override("font_disabled_color", Color(font_color, 0.4))


static func troop_texture(card: TroopCard) -> Texture2D:
	if card and card.specialty and card.specialty.texture:
		return card.specialty.texture
	return DEFAULT_SPRITE


static func specialty_color(card: TroopCard) -> Color:
	return card.specialty.color if card and card.specialty else RECRUIT


static func specialty_text(card: TroopCard) -> String:
	if card and card.specialty:
		return "%s %s" % [emo(card.specialty.emoji), card.specialty.display_name]
	return "🔰 Recluta"


## Huecos de objeto ocupados: "●●○".
static func slots_text(card: TroopCard) -> String:
	var n: int = card.items.size() if card else 0
	var s := ""
	for i in TroopCard.MAX_ITEM_SLOTS:
		s += "●" if i < n else "○"
	return s


static func pct(v: float) -> String:
	return "%d %%" % roundi(v * 100.0)


static func health_text(s: Dictionary) -> String:
	return "%d" % roundi(s.max_health)


static func damage_text(s: Dictionary) -> String:
	return pct(s.damage_mult)


static func magazine_text(m: int) -> String:
	return "∞" if m <= 0 else str(m)


## Ficha "grande" de estadística (Vida / Daño).
static func stat_tile(title: String, value: String, color: Color, value_size: int = 26, min_w: float = 0.0) -> PanelContainer:
	var p := panel(Color(color.r * 0.18, color.g * 0.18, color.b * 0.18, 1.0), Color(color, 0.55), 8, 1, 8)
	p.custom_minimum_size.x = min_w
	var v := VBoxContainer.new()
	v.add_theme_constant_override("separation", -2)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	p.add_child(v)
	var t := label(title, 12, Color(color, 0.85))
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	v.add_child(t)
	var val := label(value, value_size, color)
	val.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	val.name = "Value"
	v.add_child(val)
	return p


## Ficha de recluta (tienda y selección inicial). El VBox interior queda en meta "box"
## para que quien la usa añada su botón.
static func make_recruit_card(card: TroopCard, width: float = 230.0) -> PanelContainer:
	var s := TroopStats.compute(card)
	var w: WeaponData = s.weapon
	var root := panel(PANEL, BORDER, 10, 2, 12)
	root.custom_minimum_size = Vector2(width, 0)
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 6)
	root.add_child(box)
	root.set_meta("box", box)

	var portrait := panel(PANEL_2, Color(0, 0, 0, 0), 8, 0, 4)
	box.add_child(portrait)
	var icon := TextureRect.new()
	icon.custom_minimum_size = Vector2(0, 92)
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = troop_texture(card)
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	portrait.add_child(icon)
	var badge := label(emo(w.emoji), 26)
	badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	badge.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	portrait.add_child(badge)

	var name_l := label(card.unit_name, 20, TEXT)
	name_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_l.name = "NameLabel"
	box.add_child(name_l)
	var sub := label("%s · Nv. %d" % [specialty_text(card), card.level], 12, specialty_color(card))
	sub.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(sub)

	var tiles := HBoxContainer.new()
	tiles.add_theme_constant_override("separation", 6)
	box.add_child(tiles)
	var th := stat_tile("❤ VIDA", health_text(s), HEALTH, 22)
	th.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tiles.add_child(th)
	var td := stat_tile("💥 DAÑO", damage_text(s), DAMAGE, 22)
	td.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tiles.add_child(td)

	var wbox := panel(Color(0.09, 0.1, 0.13), Color(0, 0, 0, 0), 6, 0, 8)
	box.add_child(wbox)
	var wv := VBoxContainer.new()
	wv.add_theme_constant_override("separation", 1)
	wbox.add_child(wv)
	var wn := label("%s %s" % [emo(w.emoji), w.display_name], 14, rarity_color(w.rarity))
	wv.add_child(wn)
	var golpe := "%d" % roundi(s.hit_damage) if s.pellets <= 1 else "%d×%d" % [s.pellets, roundi(s.hit_damage)]
	wv.add_child(label("Impacto %s · %.1f disp/s" % [golpe, s.fire_rate], 11, MUTED))
	wv.add_child(label("Alcance %d · Precisión %s" % [roundi(s.attack_range), pct(s.accuracy)], 11, MUTED))
	return root
