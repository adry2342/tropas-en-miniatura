class_name TroopStats
extends RefCounted
## Única fuente de verdad de las estadísticas finales de una tropa (combate y UI).

const LEVEL_HEALTH := 0.10
const LEVEL_DAMAGE := 0.06
const BASE_MOVE_SPEED := 90.0
const MIN_MOVE_SPEED := 30.0
const AFFINITY_DAMAGE := 0.15
const AFFINITY_ACCURACY := 0.10
const DEFAULT_BURN_DURATION := 3.0
const MAX_ARMOR := 0.6
const MAX_DODGE := 0.5
const MIN_ACCURACY := 0.05
const MAX_ACCURACY := 0.98

## Claves de modificador válidas y su texto para la UI (SPEC sección 3).
const MODIFIER_KEYS := [
	"health_flat", "health_pct", "damage_pct", "fire_rate_pct", "accuracy", "crit_chance",
	"crit_mult", "range_pct", "magazine_pct", "reload_pct", "move_speed_pct", "armor",
	"dodge", "aoe_pct", "pierce", "burn_dps", "heal_pct",
]

static var _fallback_weapon: WeaponData = null


## Suma los modificadores de especialidad + habilidades + objetos.
static func collect_modifiers(card: TroopCard) -> Dictionary:
	var total := {}
	var sources: Array = []
	if card.specialty:
		sources.append(card.specialty.modifiers)
	for s in card.skills:
		if s:
			sources.append(s.modifiers)
	for it in card.items:
		if it:
			sources.append(it.modifiers)
	for mods in sources:
		for k in mods:
			total[k] = float(total.get(k, 0.0)) + float(mods[k])
	return total


static func has_affinity(card: TroopCard, weapon: WeaponData = null) -> bool:
	if weapon == null:
		weapon = card.get_weapon()
	return card.specialty != null and card.specialty.is_affine(weapon)


static func compute(card: TroopCard) -> Dictionary:
	var w: WeaponData = card.get_weapon()
	if w == null:
		if _fallback_weapon == null:
			_fallback_weapon = WeaponData.new()
			_fallback_weapon.display_name = "Puños"
		w = _fallback_weapon
	var m := collect_modifiers(card)
	var affinity := has_affinity(card, w)
	var lv: int = maxi(card.level, 1) - 1

	var max_health: float = (card.base_health * (1.0 + LEVEL_HEALTH * lv) + m.get("health_flat", 0.0)) \
			* (1.0 + m.get("health_pct", 0.0))
	var damage_mult: float = card.base_damage * (1.0 + LEVEL_DAMAGE * lv) \
			* (1.0 + m.get("damage_pct", 0.0) + (AFFINITY_DAMAGE if affinity else 0.0))
	var move_speed: float = maxf(MIN_MOVE_SPEED, BASE_MOVE_SPEED * (1.0 + m.get("move_speed_pct", 0.0)))
	var range_mult: float = 1.0 + m.get("range_pct", 0.0)
	var accuracy: float = clampf(w.accuracy + m.get("accuracy", 0.0) + (AFFINITY_ACCURACY if affinity else 0.0),
			MIN_ACCURACY, MAX_ACCURACY)
	var magazine: int = 0
	if w.magazine > 0:
		magazine = maxi(1, ceili(w.magazine * (1.0 + m.get("magazine_pct", 0.0)) - 0.0001))
	var burn_dps: float = w.burn_dps + m.get("burn_dps", 0.0)
	var burn_duration: float = w.burn_duration
	if m.get("burn_dps", 0.0) > 0.0:
		burn_duration = maxf(burn_duration, DEFAULT_BURN_DURATION)

	var s := {
		"max_health": max_health,
		"damage_mult": damage_mult,
		"move_speed": move_speed,
		"attack_range": w.attack_range * range_mult,
		"fire_rate": maxf(0.05, w.fire_rate * (1.0 + m.get("fire_rate_pct", 0.0))),
		"accuracy": accuracy,
		"optimal_range": w.optimal_range * range_mult,
		"accuracy_falloff": w.accuracy_falloff,
		"magazine": magazine,
		"reload_time": maxf(0.1, w.reload_time * (1.0 + m.get("reload_pct", 0.0))),
		"crit_chance": clampf(w.crit_chance + m.get("crit_chance", 0.0), 0.0, 1.0),
		"crit_multiplier": w.crit_multiplier + m.get("crit_mult", 0.0),
		"pellets": maxi(1, w.pellets),
		"aoe_radius": w.aoe_radius * (1.0 + m.get("aoe_pct", 0.0)) if w.aoe_radius > 0.0 else 0.0,
		"burn_dps": burn_dps,
		"burn_duration": burn_duration if burn_dps > 0.0 else 0.0,
		"armor": clampf(m.get("armor", 0.0), 0.0, MAX_ARMOR),
		"dodge": clampf(m.get("dodge", 0.0), 0.0, MAX_DODGE),
		"pierce": int(round(m.get("pierce", 0.0))),
		"weapon_damage": w.damage,
		"affinity": affinity,
		# Extras (no están en la SPEC, útiles para combate/UI)
		"heal_mult": 1.0 + m.get("heal_pct", 0.0), # multiplica las curaciones que hace la tropa
		"weapon": w,
		"modifiers": m,
	}
	s["hit_damage"] = w.damage * damage_mult
	s["dps"] = estimate_dps(s)
	return s


## DPS teórico (con precisión a distancia óptima, críticos y recarga). Para mostrar en la UI.
static func estimate_dps(s: Dictionary) -> float:
	var per_shot: float = s.hit_damage * s.pellets * s.accuracy \
			* (1.0 + s.crit_chance * (s.crit_multiplier - 1.0))
	var rate: float = s.fire_rate
	if s.magazine > 0:
		var cycle: float = s.magazine / s.fire_rate + s.reload_time
		rate = s.magazine / cycle
	return per_shot * rate + s.burn_dps


static func _pct(v: float) -> String:
	return "%d %%" % roundi(v * 100.0)


static func _signed_pct(v: float) -> String:
	return ("+" if v >= 0.0 else "−") + "%d %%" % roundi(absf(v) * 100.0)


## Texto corto de un diccionario de modificadores ("+15 de vida, +10 % de cadencia").
static func describe_modifiers(mods: Dictionary) -> String:
	var parts: Array[String] = []
	for k in mods:
		var v: float = float(mods[k])
		match k:
			"health_flat": parts.append("%+d de vida" % roundi(v))
			"health_pct": parts.append("%s de vida" % _signed_pct(v))
			"damage_pct": parts.append("%s de daño" % _signed_pct(v))
			"fire_rate_pct": parts.append("%s de cadencia" % _signed_pct(v))
			"accuracy": parts.append("%s de precisión" % _signed_pct(v))
			"crit_chance": parts.append("%s de crítico" % _signed_pct(v))
			"crit_mult": parts.append("%+.2f al multiplicador de crítico" % v)
			"range_pct": parts.append("%s de alcance" % _signed_pct(v))
			"magazine_pct": parts.append("%s de cargador" % _signed_pct(v))
			"reload_pct": parts.append("recarga %s" % _signed_pct(v))
			"move_speed_pct": parts.append("%s de movimiento" % _signed_pct(v))
			"armor": parts.append("%s de armadura" % _signed_pct(v))
			"dodge": parts.append("%s de esquiva" % _signed_pct(v))
			"aoe_pct": parts.append("%s de radio de explosión" % _signed_pct(v))
			"pierce": parts.append("atraviesa %d enemigo(s)" % roundi(v))
			"burn_dps": parts.append("quemadura de %d/s" % roundi(v))
			"heal_pct": parts.append("%s de curación" % _signed_pct(v))
			_: parts.append("%s %+.2f" % [k, v])
	return ", ".join(parts)


## Líneas legibles con las estadísticas finales, para la UI.
static func describe(card: TroopCard) -> Array[String]:
	var s := compute(card)
	var w: WeaponData = s.weapon
	var lines: Array[String] = []
	lines.append("❤ Vida: %d" % roundi(s.max_health))
	lines.append("💥 Daño: %s" % _pct(s.damage_mult))
	var arma := "%s %s (%s)" % [w.emoji, w.display_name, w.get_family_name()]
	if s.affinity:
		arma += " · afín"
	lines.append("Arma: " + arma)
	var golpe := "%d" % roundi(s.hit_damage)
	if s.pellets > 1:
		golpe = "%d × %d" % [s.pellets, roundi(s.hit_damage)]
	lines.append("Impacto: %s · %.1f disparos/s" % [golpe, s.fire_rate])
	lines.append("Precisión: %s · Crítico: %s (×%.2f)" % [_pct(s.accuracy), _pct(s.crit_chance), s.crit_multiplier])
	lines.append("Alcance: %d px (óptimo %d)" % [roundi(s.attack_range), roundi(s.optimal_range)])
	if s.magazine > 0:
		lines.append("Cargador: %d · recarga %.1f s" % [s.magazine, s.reload_time])
	else:
		lines.append("Cargador: ∞")
	if s.aoe_radius > 0.0:
		lines.append("Explosión: radio %d" % roundi(s.aoe_radius))
	if s.burn_dps > 0.0:
		lines.append("Quemadura: %d/s durante %.0f s" % [roundi(s.burn_dps), s.burn_duration])
	if s.armor > 0.0:
		lines.append("Armadura: %s" % _pct(s.armor))
	if s.dodge > 0.0:
		lines.append("Esquiva: %s" % _pct(s.dodge))
	if s.pierce > 0:
		lines.append("Atraviesa: %d enemigo(s)" % s.pierce)
	if s.heal_mult != 1.0:
		lines.append("Curación: %s" % _pct(s.heal_mult))
	lines.append("Movimiento: %d" % roundi(s.move_speed))
	lines.append("DPS estimado: %.1f" % s.dps)
	return lines
