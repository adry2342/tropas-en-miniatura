[resource]
script = ExtResource("1_script")
id = "infiltrado"
display_name = "Infiltrado"
description = "Se cuela en las líneas enemigas: al empezar la ronda aparece a la espalda del enemigo. Afín a cuchillos y pistolas."
emoji = "🗡️"
color = Color(0.72, 0.5, 0.95, 1)
affine_families = Array[int]([6, 0])
passive_name = "Tras las líneas"
passive_description = "Mecánica pendiente de diseñar (aún no tiene efecto en combate)."
synergy_text = "Pendiente: sinergias con quien atrae la atención del enemigo por delante."
