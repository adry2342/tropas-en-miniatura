[ext_resource type="Script" path="res://Scripts/Resources/specialty_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "soldado"
display_name = "Soldado"
emoji = "🎖️"
color = Color(0.45, 0.85, 0.45, 1)
affine_families = Array[int]([1, 2])
description = "Infantería de línea. Afín a automáticas y escopetas. Fija al enemigo con fuego constante."
passive_name = "Fuego de supresión"
passive_description = "Cada impacto suprime al blanco 1,5 s: −15 % de precisión y −25 % de velocidad. Un enemigo suprimido no puede avanzar ni apuntar bien."
passive_effect_id = "supresion"
passive_params = {"duration": 1.5}
modifiers = {}
extra_effects = {}
synergy_text = "Con un Vigía: los suprimidos reciben sus disparos a la cabeza (+25 % de crítico). Delante de un Doctor aguanta en primera línea mucho más."
